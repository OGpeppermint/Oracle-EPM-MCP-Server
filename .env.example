EPM_BASE_URL=https://example.oraclecloud.com
EPM_USERNAME=service.account@example.com
EPM_PASSWORD=replace-me
# Optional default; omit to discover applications and pass application arguments explicitly.
EPM_APPLICATION=example
# Total Oracle operation deadline, including retry waits and summary compatibility fallback.
EPM_REQUEST_TIMEOUT_MS=30000
# Additional GET attempts; 0 disables transient retries. POST requests are not retried.
EPM_MAX_RETRIES=2
# Maximum decoded Oracle response size in bytes (5 MiB).
EPM_MAX_RESPONSE_BYTES=5242880
# Total time allowed for each asynchronous Oracle extraction or import poll (1–3600 seconds).
EPM_CREATE_RULE_POLL_TIMEOUT_MS=300000
PORT=3001
HOST=127.0.0.1
# Comma-separated HTTP Host header allowlist; hostnames only, without scheme or port.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Browser origins (scheme + hostname + optional port), separated by commas.
# For the local Command Center, use http://localhost:5173. Empty allows no browser origins.
MCP_ALLOWED_ORIGINS=
# HTTP shutdown deadline in milliseconds; keep below the hosting platform's termination limit.
SHUTDOWN_TIMEOUT_MS=25000

